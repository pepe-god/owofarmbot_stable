{
    "name": "owofarmbot_stable",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.9.0",
    "description": "Discord OwO farm bot stable with CAPTCHA(BAN) protection",
    "main": "src/core/bot.js",
    "repository": {
        "type": "git",
        "url": ""
    },
    "keywords": [
        "nodejs",
        "bot",
        "selfbot",
        "selfbot-for-discord",
        "owo",
        "owo-bot",
        "owo-self-bot",
        "owofarm",
        "discord-owo-selfbot",
        "self-owo",
        "owofarmbot",
        "owoautofarm",
        "owobot",
        "owoautofarmer"
    ],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "scripts": {
        "start": "node --import tsx src/core/bot.js",
        "run": "node --import tsx src/core/bot.js",
        "dev": "node --import tsx src/core/bot.js",
        "build": "esbuild src/core/bot.ts --bundle --platform=node --format=cjs --outfile=dist/bot.js --packages=external --tsconfig=tsconfig.json --sourcemap",
        "typecheck": "tsc --noEmit",
        "setup": "pnpm install",
        "test": "node --import tsx --test \"tests/**/*.test.js\"",
        "lint": "biome check .",
        "format": "biome format --write .",
        "lint:fix": "biome check --write ."
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "debug": "^4.4.3",
        "discord.js-selfbot-v13": "^3.6.1",
        "dotenv": "^17.4.2",
        "node-notifier": "^10.0.1"
    },
    "bugs": {
        "url": ""
    },
    "homepage": "",
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@types/chalk": "^2.2.4",
        "@types/debug": "^4.1.13",
        "@types/dotenv": "^8.2.3",
        "@types/node": "^26.1.1",
        "@types/node-notifier": "^8.0.5",
        "esbuild": "^0.28.1",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "pnpm": {
        "public-hoist-pattern": [
            "debug"
        ]
    }
}
